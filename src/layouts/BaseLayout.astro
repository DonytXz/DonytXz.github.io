---
import { createHash } from 'node:crypto';
import { profile } from '../data/portfolio';
import earlyPreferences from '../scripts/early-preferences.js?raw';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Donato Alvarez — Sr Software Engineer',
  description = profile.description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Hash the exact trusted source emitted below; normalize HTML parser line endings.
const preferenceScript = earlyPreferences.replace(/\r\n?/g, '\n');
Astro.csp?.insertScriptHash(
  `sha256-${createHash('sha256').update(preferenceScript).digest('base64')}`,
);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='12' fill='%231e293b'/%3E%3Ctext x='50' y='68' font-family='monospace' font-size='48' font-weight='bold' fill='%23f8fafc' text-anchor='middle'%3EDA%3C/text%3E%3C/svg%3E"
    />
    <script is:inline set:html={preferenceScript}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
