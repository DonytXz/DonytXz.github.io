---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SystemSpecs from '../components/SystemSpecs.astro';
import AuditDialog from '../components/AuditDialog.astro';
import LocalizedText from '../components/LocalizedText.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
// import Projects from '../components/sections/Projects.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <a href="#main" class="skip-link">
    <LocalizedText
      text={{ en: 'Skip to main content', es: 'Saltar al contenido principal' }}
    />
  </a>
  <div class="portfolio-shell">
    <SiteHeader />
    <div class="reading-column">
      <main id="main" class="content" tabindex="-1">
        <About />
        <Experience />
        {/* <Projects /> */}
        <Contact />
      </main>
      <SystemSpecs />
      <SiteFooter />
    </div>
  </div>
  <AuditDialog />
</BaseLayout>
<script>
  import '../scripts/portfolio';
</script>
