---
import LocalizedText from './LocalizedText.astro';
import audit from '../data/audit.json';
---

<dialog
  id="lighthouse-dialog"
  class="audit-dialog"
  aria-labelledby="dialog-title"
  aria-describedby="audit-context"
>
  <div class="dialog-header">
    <div>
      <h2 id="dialog-title">
        <LocalizedText
          text={{
            en: 'Google Lighthouse Audit Report',
            es: 'Reporte de Google Lighthouse',
          }}
        />
      </h2>
      <p id="audit-context" class="audit-context">
        <LocalizedText
          text={{ en: 'Production preview', es: 'Vista previa de producción' }}
        />{' '}
        ·
        <time datetime={audit.date}>
          {audit.date ? audit.date.slice(0, 10) : '—'}
        </time>
        {audit.url && (
          <>
            {' '}
            · <span>{audit.url}</span>
          </>
        )}
      </p>
    </div>
    <div class="dialog-actions">
      <a
        href="/lighthouse-report.report.html"
        target="_blank"
        rel="noopener noreferrer"
        class="dialog-ext-link"
        title="Open report in separate browser tab"
      >
        <LocalizedText
          text={{ en: 'Open in new tab ↗', es: 'Abrir en nueva pestaña ↗' }}
        />
      </a>
      <button
        type="button"
        id="close-audit-btn"
        class="dialog-close-btn"
        aria-label="Close audit report"
      >
        ×
      </button>
    </div>
  </div>
  <div class="dialog-body">
    <iframe
      id="audit-iframe"
      title="Google Lighthouse Audit Report"
      loading="lazy"
    ></iframe>
  </div>
</dialog>
