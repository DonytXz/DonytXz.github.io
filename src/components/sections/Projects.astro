---
import { projects } from '../../data/projects';
import LocalizedText from '../LocalizedText.astro';
import PortfolioSection from '../PortfolioSection.astro';
import ProjectCard from '../ProjectCard.astro';

const featuredProjects = projects.slice(0, 3);
---

<PortfolioSection id="projects">
  {featuredProjects.map((project) => (
    <ProjectCard project={project} />
  ))}
  <div class="projects-more">
    <a href="/proyects" class="projects-more-link">
      <LocalizedText text={{ en: 'View more', es: 'Ver más' }} />
      <span aria-hidden="true"> →</span>
    </a>
  </div>
</PortfolioSection>
