---
import { profile, languages, sections } from '../data/portfolio';
import LocalizedText from './LocalizedText.astro';
import PreferenceControls from './PreferenceControls.astro';
import SocialLinks from './SocialLinks.astro';

// Match the published sections in index.astro. Projects is temporarily disabled;
// Skills and Education have been removed from the page.
const navigationSections = sections.filter(
  ({ id }) => id === 'about' || id === 'experience' || id === 'contact',
);
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-identity">
      <h1 class="site-title">{profile.name}</h1>
      {languages.map((lang) => (
        <p class="site-subtitle" data-lang={lang} lang={lang}>
          {profile.subtitle[lang]}
        </p>
      ))}
    </div>
    <PreferenceControls />
    <nav class="site-nav" aria-label="Main navigation">
      {navigationSections.map(({ id, nav }) => (
        <a href={`#${id}`} class="section-link">
          <span class="nav-indicator" aria-hidden="true" />
          <span class="nav-label">
            <LocalizedText text={nav} />
          </span>
        </a>
      ))}
    </nav>
    <div class="header-bottom">
      <SocialLinks />
    </div>
  </div>
</header>
