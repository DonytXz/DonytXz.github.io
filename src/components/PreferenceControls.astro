---
import Flag from './Flag.astro';
---

<div class="nav-controls">
  <button
    type="button"
    id="lang-toggle"
    class="theme-toggle"
    aria-label="Cambiar idioma a Español (México)"
    title="Switch language (EN / ES)"
  >
    <span data-lang="en" class="lang-btn-content">
      [&nbsp;
      <Flag country="MX" />
      ES&nbsp;]
    </span>
    <span data-lang="es" class="lang-btn-content">
      [&nbsp;
      <Flag country="US" />
      EN&nbsp;]
    </span>
  </button>
  <button
    type="button"
    id="theme-toggle"
    class="theme-toggle"
    aria-label="Switch to dark mode"
    aria-pressed="false"
    title="Toggle dark / light mode"
  >
    [ ◐ Dark ]
  </button>
</div>
