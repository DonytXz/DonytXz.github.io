---
import Flag from './Flag.astro';
import Icon from './Icon.astro';
import LocalizedText from './LocalizedText.astro';
---

<div class="nav-controls">
  <button
    type="button"
    id="lang-toggle"
    class="theme-toggle"
    aria-label="Cambiar idioma a Español (México)"
    title="Switch language (EN / ES)"
  >
    <span data-lang="en" class="lang-btn-content">
      <Flag country="MX" />
      ES
    </span>
    <span data-lang="es" class="lang-btn-content">
      <Flag country="US" />
      EN
    </span>
  </button>
  <button
    type="button"
    id="theme-toggle"
    class="theme-toggle"
    aria-label="Switch to dark mode"
    aria-pressed="false"
    title="Toggle dark / light mode"
  >
    <Icon name="moon" class="theme-moon" />
    <Icon name="sun" class="theme-sun" />
    <span id="theme-label">
      <LocalizedText text={{ en: 'Dark', es: 'Oscuro' }} />
    </span>
  </button>
</div>
